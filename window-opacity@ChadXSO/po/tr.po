#. applet.js:60
msgid "Window opacity (click, or scroll on this icon)"
msgstr "Pencere şeffaflığı (bu simgeye tıkla ya da üstünde kaydır)"

#. applet.js:104
msgid "Make this app solid"
msgstr "Bu pencereyi koyu yap"

#. applet.js:108
msgid "Put this app back on the default"
msgstr "Bu uygulamayı varsayılana sıfırla"

#. applet.js:199
#, javascript-format
msgid "Default for all apps: %s"
msgstr "Tüm pencereler için varsayılan: %s"

#. applet.js:202
msgid "Click on a window first"
msgstr "Bir pencereye tıklayın"

#. applet.js:208
#, javascript-format
msgid "%s (default)"
msgstr "%s (varsayılan)"

#. metadata.json->name
msgid "Window Opacity"
msgstr "Pencere Şeffaflığı"

#. metadata.json->description
msgid ""
"See-through windows with a default opacity for every app, plus a remembered "
"setting per app"
msgstr ""
"Şeffaf pencereler, her uygulama için varsayılan bir şeffaflık değerine "
"sahiptir; ayrıca her uygulamanın özel ayarlarını hatırlar"

#. settings-schema.json->default-opacity->description
msgid "Default opacity for every app (%)"
msgstr "Her uygulama için varsayılan şeffaflık (%)"

#. settings-schema.json->default-opacity->tooltip
msgid "Apps you haven't given their own setting open at this opacity."
msgstr ""
"Ayarlarını tanımlamadığınız uygulamalar, bu şeffaflık değeriyle açılır."
